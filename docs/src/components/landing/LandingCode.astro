---
---
<section class="bd">
  <div class="lc" style="padding-top:0;padding-bottom:0">
    <div class="l-split l-split-flush">
      <div class="l-split-left">
        <span class="l-split-label">Quick start</span>
        <h2 class="l-split-title">Three files.<br>That's it.</h2>
        <p class="l-split-desc">Create your auth instance, mount the handler. Every route is live immediately.</p>
      </div>
      <div class="l-split-right" style="padding:0">
        <div class="l-qs-grid" style="border:none;margin:0">
          <div class="l-qs-panel">
            <div class="l-qs-hd">
              <span class="l-qs-file">auth.ts</span>
              <span class="l-qs-lang">middleware</span>
            </div>
            <div class="l-qs-body">
              <div><span class="tk-kw">import</span> <span class="tk-punc">&#123;</span> <span class="tk-prop">gatelyAuth</span> <span class="tk-punc">&#125;</span> <span class="tk-kw">from</span> <span class="tk-str">'@gately/auth-core'</span></div>
              <div><span class="tk-kw">import</span> <span class="tk-punc">&#123;</span> <span class="tk-prop">createD1Adapter</span><span class="tk-punc">,</span> <span class="tk-prop">createKVStore</span> <span class="tk-punc">&#125;</span></div>
              <div style="margin-left:16px"><span class="tk-kw">from</span> <span class="tk-str">'@gately/auth-core/adapters'</span></div>
              <div>&nbsp;</div>
              <div><span class="tk-kw">export const</span> <span class="tk-fn">auth</span> <span class="tk-op">=</span> <span class="tk-fn">gatelyAuth</span><span class="tk-punc">(&#123;</span></div>
              <div>&nbsp;&nbsp;<span class="tk-prop">secret</span><span class="tk-punc">:</span> <span class="tk-val">env</span><span class="tk-punc">.</span><span class="tk-prop">AUTH_SECRET</span><span class="tk-punc">,</span></div>
              <div>&nbsp;&nbsp;<span class="tk-prop">db</span><span class="tk-punc">:</span> <span class="tk-fn">createD1Adapter</span><span class="tk-punc">(</span><span class="tk-val">env</span><span class="tk-punc">.</span><span class="tk-prop">AUTH_DB</span><span class="tk-punc">),</span></div>
              <div>&nbsp;&nbsp;<span class="tk-prop">kv</span><span class="tk-punc">:</span> <span class="tk-fn">createKVStore</span><span class="tk-punc">(</span><span class="tk-val">env</span><span class="tk-punc">.</span><span class="tk-prop">AUTH_KV</span><span class="tk-punc">),</span></div>
              <div>&nbsp;&nbsp;<span class="tk-prop">emailAndPassword</span><span class="tk-punc">:</span> <span class="tk-punc">&#123;</span> <span class="tk-prop">enabled</span><span class="tk-punc">:</span> <span class="tk-kw">true</span> <span class="tk-punc">&#125;,</span></div>
              <div><span class="tk-punc">&#125;)</span></div>
            </div>
          </div>
          <div class="l-qs-panel">
            <div class="l-qs-hd"><span class="l-qs-file">middleware.ts</span><span class="l-qs-lang">worker</span></div>
            <div class="l-qs-body">
              <div><span class="tk-kw">import</span> <span class="tk-punc">&#123;</span> <span class="tk-prop">auth</span> <span class="tk-punc">&#125;</span> <span class="tk-kw">from</span> <span class="tk-str">'./auth'</span></div>
              <div>&nbsp;</div>
              <div><span class="tk-kw">export default</span> <span class="tk-punc">&#123;</span></div>
              <div>&nbsp;&nbsp;<span class="tk-kw">async</span> <span class="tk-fn">fetch</span><span class="tk-punc">(</span><span class="tk-val">req</span><span class="tk-punc">,</span> <span class="tk-val">env</span><span class="tk-punc">) &#123;</span></div>
              <div>&nbsp;&nbsp;&nbsp;&nbsp;<span class="tk-kw">return</span> <span class="tk-val">auth</span><span class="tk-punc">.</span><span class="tk-fn">handler</span><span class="tk-punc">(</span><span class="tk-val">req</span><span class="tk-punc">)</span></div>
              <div>&nbsp;&nbsp;<span class="tk-punc">&#125;</span></div>
              <div><span class="tk-punc">&#125;</span></div>
              <div>&nbsp;</div>
              <div><span class="tk-cm">// Protect any route</span></div>
              <div><span class="tk-kw">const</span> <span class="tk-val">session</span> <span class="tk-op">=</span> <span class="tk-kw">await</span> <span class="tk-val">auth</span><span class="tk-punc">.</span><span class="tk-val">api</span><span class="tk-punc">.</span><span class="tk-fn">getSession</span><span class="tk-punc">(</span><span class="tk-val">req</span><span class="tk-punc">)</span></div>
            </div>
          </div>
          <div class="l-qs-panel">
            <div class="l-qs-hd"><span class="l-qs-file">services.ts</span><span class="l-qs-lang">hono</span></div>
            <div class="l-qs-body">
              <div><span class="tk-kw">import</span> <span class="tk-punc">&#123;</span> <span class="tk-prop">Hono</span> <span class="tk-punc">&#125;</span> <span class="tk-kw">from</span> <span class="tk-str">'hono'</span></div>
              <div><span class="tk-kw">import</span> <span class="tk-punc">&#123;</span> <span class="tk-prop">auth</span> <span class="tk-punc">&#125;</span> <span class="tk-kw">from</span> <span class="tk-str">'./auth'</span></div>
              <div>&nbsp;</div>
              <div><span class="tk-kw">const</span> <span class="tk-val">app</span> <span class="tk-op">=</span> <span class="tk-kw">new</span> <span class="tk-fn">Hono</span><span class="tk-punc">()</span></div>
              <div>&nbsp;</div>
              <div><span class="tk-val">app</span><span class="tk-punc">.</span><span class="tk-fn">all</span><span class="tk-punc">(</span><span class="tk-str">'/auth/*'</span><span class="tk-punc">, (</span><span class="tk-val">c</span><span class="tk-punc">) =&gt;</span></div>
              <div>&nbsp;&nbsp;<span class="tk-val">auth</span><span class="tk-punc">.</span><span class="tk-fn">handler</span><span class="tk-punc">(</span><span class="tk-val">c</span><span class="tk-punc">.</span><span class="tk-val">req</span><span class="tk-punc">.</span><span class="tk-val">raw</span><span class="tk-punc">))</span></div>
              <div>&nbsp;</div>
              <div><span class="tk-val">app</span><span class="tk-punc">.</span><span class="tk-fn">get</span><span class="tk-punc">(</span><span class="tk-str">'/api/me'</span><span class="tk-punc">,</span> <span class="tk-kw">async</span> <span class="tk-punc">(</span><span class="tk-val">c</span><span class="tk-punc">) =&gt; &#123;</span></div>
              <div>&nbsp;&nbsp;<span class="tk-kw">const</span> <span class="tk-val">s</span> <span class="tk-op">=</span> <span class="tk-kw">await</span> <span class="tk-val">auth</span><span class="tk-punc">.</span><span class="tk-val">api</span><span class="tk-punc">.</span><span class="tk-fn">getSession</span><span class="tk-punc">(</span><span class="tk-val">c</span><span class="tk-punc">.</span><span class="tk-val">req</span><span class="tk-punc">.</span><span class="tk-val">raw</span><span class="tk-punc">)</span></div>
              <div>&nbsp;&nbsp;<span class="tk-kw">return</span> <span class="tk-val">c</span><span class="tk-punc">.</span><span class="tk-fn">json</span><span class="tk-punc">(</span><span class="tk-val">s</span><span class="tk-punc">)</span></div>
              <div><span class="tk-punc">&#125;)</span></div>
              <div>&nbsp;</div>
              <div><span class="tk-kw">export default</span> <span class="tk-val">app</span></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
