---
import BrandIcon from './BrandIcon.astro';
---
<section class="bd">
  <div class="lc" style="padding-top:0;padding-bottom:0">
    <div class="l-split">
      <div class="l-split-left">
        <span class="l-split-label">Social sign-in</span>
        <h2 class="l-split-title">Every OAuth provider.</h2>
        <p class="l-split-desc">Pre-built integrations with 20+ providers.</p>
      </div>
      <div class="l-split-right" style="padding-left:40px;padding-top:40px;padding-bottom:40px">
        <div class="l-providers-row" style="margin-top:0">
          <span class="l-prov-badge"><BrandIcon name="google" size={14} />Google</span>
          <span class="l-prov-badge"><BrandIcon name="github" size={14} />GitHub</span>
          <span class="l-prov-badge"><BrandIcon name="discord" size={14} />Discord</span>
          <span class="l-prov-badge"><BrandIcon name="microsoft" size={14} />Microsoft</span>
          <span class="l-prov-badge"><BrandIcon name="apple" size={14} />Apple</span>
          <span class="l-prov-badge"><BrandIcon name="facebook" size={14} />Facebook</span>
          <span class="l-prov-badge"><BrandIcon name="slack" size={14} />Slack</span>
          <span class="l-prov-badge"><BrandIcon name="linkedin" size={14} />LinkedIn</span>
          <span class="l-prov-badge"><BrandIcon name="x" size={14} />Twitter / X</span>
          <span class="l-prov-badge"><BrandIcon name="gitlab" size={14} />GitLab</span>
          <span class="l-prov-badge"><BrandIcon name="bitbucket" size={14} />Bitbucket</span>
          <span class="l-prov-badge"><BrandIcon name="spotify" size={14} />Spotify</span>
          <span class="l-prov-badge"><BrandIcon name="notion" size={14} />Notion</span>
          <span class="l-prov-more">+ More</span>
        </div>
      </div>
    </div>
  </div>
</section>
