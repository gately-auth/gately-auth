---
---
<section class="bd">
  <div class="lc" style="padding-top:0;padding-bottom:0">
    <div class="l-split l-split-flush">
      <div class="l-split-left">
        <span class="l-split-label">MCP</span>
        <h2 class="l-split-title">Built for AI agents.</h2>
        <p class="l-split-desc">Connect Cursor, Claude Code, Kiro, or any MCP client directly to the gately-auth docs.</p>
      </div>
      <div class="l-split-right" style="padding:0">
        <div class="l-mcp-grid" style="margin-top:0">
          <div class="l-mcp-left" style="padding:28px 28px 28px 32px">
            <p style="font-size:10px;letter-spacing:0.1em;text-transform:uppercase;color:#444;margin-bottom:16px;font-family:'Geist Mono',monospace">How to connect</p>
            <div class="l-mcp-clients">
              <div class="l-mcp-client"><span class="l-mcp-dot"></span><span>Cursor &mdash; <code>~/.cursor/mcp.json</code></span></div>
              <div class="l-mcp-client"><span class="l-mcp-dot"></span><span>Claude Code &mdash; <code>claude mcp add</code></span></div>
              <div class="l-mcp-client"><span class="l-mcp-dot"></span><span>Kiro &mdash; <code>.kiro/settings/mcp.json</code></span></div>
              <div class="l-mcp-client"><span class="l-mcp-dot"></span><span>Any HTTP MCP client</span></div>
            </div>
            <div class="l-mcp-endpoint">
              <span style="color:#1e1e1e">endpoint</span>
              <code>https://mcp.auth.usegately.com/mcp</code>
            </div>
            <div class="l-mcp-json">
              <p class="l-mcp-json-label">mcp.json</p>
              <pre>&#123;
  <span style="color:#444">"gately-auth"</span>: &#123;
    <span style="color:#444">"url"</span>: <span style="color:#555">"https://mcp.auth.usegately.com/mcp"</span>
  &#125;
&#125;</pre>
            </div>
          </div>
          <div class="l-mcp-right">
            <div class="l-mcp-panel-hd">Available tools</div>
            <div class="l-mcp-tools">
              <div class="l-mcp-tool"><span class="l-mcp-tool-name">search_docs</span><span class="l-mcp-tool-desc">Search docs by keyword or concept</span></div>
              <div class="l-mcp-tool"><span class="l-mcp-tool-name">get_doc</span><span class="l-mcp-tool-desc">Fetch a full article by slug</span></div>
              <div class="l-mcp-tool"><span class="l-mcp-tool-name">list_docs</span><span class="l-mcp-tool-desc">List all articles by category</span></div>
              <div class="l-mcp-tool"><span class="l-mcp-tool-name">get_quickstart</span><span class="l-mcp-tool-desc">Complete scaffold for Hono or Next.js</span></div>
              <div class="l-mcp-tool"><span class="l-mcp-tool-name">get_install_command</span><span class="l-mcp-tool-desc">Right install command for any package manager</span></div>
              <div class="l-mcp-tool"><span class="l-mcp-tool-name">get_all_docs</span><span class="l-mcp-tool-desc">Full documentation as a single text file</span></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
