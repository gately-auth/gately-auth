---
---
<section class="bd">
  <div class="lc" style="padding-top:0;padding-bottom:0">
    <div class="l-split">
      <div class="l-split-left">
        <span class="l-split-label">Monorepo</span>
        <h2 class="l-split-title">Official packages.</h2>
        <p class="l-split-desc">Modular, lightweight, tree-shakeable.</p>
      </div>
      <div class="l-split-right" style="padding-left:40px;padding-top:40px;padding-bottom:40px">
        <div style="display:flex;justify-content:flex-end;margin-bottom:16px">
          <a href="https://www.npmjs.com/search?q=%40gately" class="l-pkg-view-all" target="_blank" rel="noopener">View all packages &rarr;</a>
        </div>
        <div class="l-pkg-grid" style="margin-top:0">
          <a href="https://www.npmjs.com/package/@gately/auth-core" class="l-pkg-card" target="_blank" rel="noopener">
            <p class="l-pkg-name">@gately/auth-core</p>
            <p class="l-pkg-sub">Core auth engine</p>
            <p class="l-pkg-desc">Worker handler, D1/KV adapters, all auth providers and plugins</p>
            <span class="l-pkg-ver">v0.1.0</span>
          </a>
          <a href="https://www.npmjs.com/package/@gately/auth-client" class="l-pkg-card" target="_blank" rel="noopener">
            <p class="l-pkg-name">@gately/auth-client</p>
            <p class="l-pkg-sub">Browser client SDK</p>
            <p class="l-pkg-desc">React hooks, Vue composables, Svelte stores and components</p>
            <span class="l-pkg-ver">v0.1.0</span>
          </a>
          <a href="https://www.npmjs.com/package/@gately/auth-cli" class="l-pkg-card" target="_blank" rel="noopener">
            <p class="l-pkg-name">@gately/auth-cli</p>
            <p class="l-pkg-sub">CLI tool</p>
            <p class="l-pkg-desc">Scaffold, login, auto-provision D1/KV, migrate and deploy</p>
            <span class="l-pkg-ver">v0.1.0</span>
          </a>
          <a href="https://mcp.auth.usegately.com" class="l-pkg-card" target="_blank" rel="noopener">
            <p class="l-pkg-name">@gately/auth-mcp</p>
            <p class="l-pkg-sub">AI editor integration</p>
            <p class="l-pkg-desc">Live doc access for Cursor, Claude, Kiro and any MCP client</p>
            <span class="l-pkg-ver">v0.1.0</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
