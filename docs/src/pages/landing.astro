  <!-- ── QUICK START ── -->
  <section class="section section-border">
    <div class="container">
      <div class="section-label">Quick start</div>
      <h2 class="section-title">Three files. That's it.</h2>
      <div class="quickstart-grid">
        <div class="qs-panel">
          <div class="qs-panel-header">
            <span class="qs-panel-file">auth.ts</span>
            <span class="code-window-lang">TypeScript</span>
          </div>
          <div class="qs-panel-body">
            <div><span class="kw">import</span> <span class="prop">{ gatelyAuth }</span> <span class="kw">from</span> <span class="str">'@gately/auth-core'</span></div>
            <div><span class="kw">import</span> <span class="prop">{ createD1Adapter, createKVStore }</span></div>
            <div>&nbsp;&nbsp;<span class="kw">from</span> <span class="str">'@gately/auth-core/adapters'</span></div>
            <div>&nbsp;</div>
            <div><span class="kw">export function</span> <span class="fn">createAuth</span>(<span class="prop">env</span>) {</div>
            <div>&nbsp;&nbsp;<span class="kw">return</span> <span class="fn">gatelyAuth</span>({</div>
            <div>&nbsp;&nbsp;&nbsp;&nbsp;<span class="prop">secret</span>: <span class="prop">env</span>.<span class="fn">AUTH_SECRET</span>,</div>
            <div>&nbsp;&nbsp;&nbsp;&nbsp;<span class="prop">db</span>: <span class="fn">createD1Adapter</span>(<span class="prop">env</span>.<span class="fn">AUTH_DB</span>),</div>
            <div>&nbsp;&nbsp;&nbsp;&nbsp;<span class="prop">kv</span>: <span class="fn">createKVStore</span>(<span class="prop">env</span>.<span class="fn">AUTH_KV</span>),</div>
            <div>&nbsp;&nbsp;&nbsp;&nbsp;<span class="prop">emailAndPassword</span>: { <span class="prop">enabled</span>: <span class="kw">true</span> },</div>
            <div>&nbsp;&nbsp;})</div>
            <div>}</div>
          </div>
        </div>
        <div class="qs-panel">
          <div class="qs-panel-header">
            <span class="qs-panel-file">middleware.ts</span>
            <span class="code-window-lang">TypeScript</span>
          </div>
          <div class="qs-panel-body">
            <div><span class="kw">import</span> <span class="prop">{ auth }</span> <span class="kw">from</span> <span class="str">'./auth'</span></div>
            <div>&nbsp;</div>
            <div><span class="kw">export default</span> {</div>
            <div>&nbsp;&nbsp;<span class="kw">async</span> <span class="fn">fetch</span>(<span class="prop">req</span>, <span class="prop">env</span>) {</div>
            <div>&nbsp;&nbsp;&nbsp;&nbsp;<span class="kw">const</span> <span class="prop">a</span> = <span class="fn">createAuth</span>(<span class="prop">env</span>)</div>
            <div>&nbsp;&nbsp;&nbsp;&nbsp;<span class="kw">return</span> <span class="prop">a</span>.<span class="fn">handler</span>(<span class="prop">req</span>)</div>
            <div>&nbsp;&nbsp;}</div>
            <div>}</div>
          </div>
        </div>
        <div class="qs-panel">
          <div class="qs-panel-header">
            <span class="qs-panel-file">services.ts</span>
            <span class="code-window-lang">TypeScript</span>
          </div>
          <div class="qs-panel-body">
            <div><span class="kw">import</span> <span class="prop">{ auth }</span> <span class="kw">from</span> <span class="str">'./auth'</span></div>
            <div><span class="kw">import</span> <span class="prop">{ Hono }</span> <span class="kw">from</span> <span class="str">'hono'</span></div>
            <div>&nbsp;</div>
            <div><span class="kw">const</span> <span class="prop">app</span> = <span class="kw">new</span> <span class="fn">Hono</span>()</div>
            <div>&nbsp;</div>
            <div><span class="prop">app</span>.<span class="fn">get</span>(<span class="str">'/api/me'</span>, <span class="kw">async</span> (<span class="prop">c</span>) => {</div>
            <div>&nbsp;&nbsp;<span class="kw">const</span> <span class="prop">auth</span> = <span class="fn">createAuth</span>(<span class="prop">c</span>.<span class="prop">env</span>)</div>
            <div>&nbsp;&nbsp;<span class="kw">const</span> <span class="prop">s</span> = <span class="kw">await</span> <span class="prop">auth</span>.<span class="prop">api</span>.<span class="fn">getSession</span>(<span class="prop">c</span>.<span class="prop">req</span>.<span class="prop">raw</span>)</div>
            <div>&nbsp;&nbsp;<span class="kw">return</span> <span class="prop">c</span>.<span class="fn">json</span>(<span class="prop">s</span>)</div>
            <div>})</div>
            <div>&nbsp;</div>
            <div><span class="kw">export default</span> <span class="prop">app</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

