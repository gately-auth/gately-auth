---
export const prerender = false;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Gately Auth — Auth for Cloudflare Workers</title>
  <meta name="description" content="The authentication framework built specifically for Cloudflare Workers and the edge." />
  <style>
    @font-face {
      font-family: 'Geist Mono';
      src: url('/Geist_Mono/GeistMono-VariableFont_wght.ttf') format('truetype-variations');
      font-weight: 100 900;
      font-style: normal;
      font-display: swap;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg: #0a0a0a;
      --bg1: #111111;
      --bg2: #161616;
      --border: #1e1e1e;
      --border2: #2a2a2a;
      --fg: #ffffff;
      --fg1: #e4e4e7;
      --fg2: #a1a1aa;
      --fg3: #71717a;
      --fg4: #52525b;
      --fg5: #3f3f46;
      --accent: #ffffff;
      --green: #22c55e;
      --blue: #3b82f6;
      --yellow: #eab308;
      --red: #ef4444;
      --purple: #a855f7;
      --mono: 'Geist Mono', ui-monospace, 'Cascadia Code', Menlo, Consolas, monospace;
    }

    html, body {
      background: var(--bg);
      color: var(--fg1);
      font-family: var(--mono);
      font-size: 13px;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    a { color: inherit; text-decoration: none; }
    button { cursor: pointer; font-family: var(--mono); }

    .container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
    .section-border { border-bottom: 1px solid var(--border); }

    /* ── TOP BAR ── */
    .topbar {
      border-bottom: 1px solid var(--border);
      padding: 6px 0;
      background: var(--bg);
    }
    .topbar-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }
    .topbar-left {
      display: flex;
      align-items: center;
      gap: 20px;
    }
    .version-badge {
      font-size: 10px;
      color: var(--fg4);
      letter-spacing: 0.06em;
    }
    .prod-badge {
      font-size: 10px;
      color: var(--green);
      border: 1px solid #166534;
      padding: 1px 7px;
      letter-spacing: 0.06em;
    }

    /* ── NAV ── */
    nav {
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      background: var(--bg);
      z-index: 100;
    }
    .nav-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 48px;
    }
    .nav-logo {
      font-weight: 700;
      font-size: 13px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--fg);
    }
    .nav-links {
      display: flex;
      align-items: center;
      gap: 24px;
    }
    .nav-link {
      font-size: 12px;
      color: var(--fg3);
      letter-spacing: 0.04em;
    }
    .nav-link:hover { color: var(--fg); }
    .nav-actions { display: flex; align-items: center; gap: 8px; }
    .btn-sm {
      font-size: 11px;
      font-family: var(--mono);
      letter-spacing: 0.06em;
      padding: 5px 14px;
      border: 1px solid var(--border2);
      background: transparent;
      color: var(--fg2);
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .btn-sm:hover { border-color: var(--fg4); color: var(--fg1); }
    .btn-sm-primary {
      background: var(--fg);
      color: var(--bg);
      border-color: var(--fg);
      font-size: 11px;
      font-family: var(--mono);
      letter-spacing: 0.06em;
      padding: 5px 14px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .btn-sm-primary:hover { background: #e4e4e7; }
    .star-count {
      font-size: 10px;
      color: var(--fg4);
    }
  </style>
    /* ── HERO ── */
    .hero {
      padding: 56px 0 0;
      border-bottom: 1px solid var(--border);
      overflow: hidden;
    }
    .hero-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0;
      align-items: start;
    }
    .hero-left { padding-bottom: 56px; padding-right: 48px; }
    .hero-right {
      border-left: 1px solid var(--border);
      background: var(--bg1);
      min-height: 420px;
      overflow: hidden;
    }
    .hero-eyebrow {
      font-size: 10px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--fg4);
      margin-bottom: 16px;
    }
    h1 {
      font-size: clamp(32px, 5vw, 56px);
      font-weight: 800;
      letter-spacing: -0.02em;
      line-height: 1.05;
      color: var(--fg);
      margin-bottom: 16px;
    }
    .hero-sub {
      font-size: 13px;
      color: var(--fg3);
      max-width: 440px;
      line-height: 1.7;
      margin-bottom: 28px;
    }
    .tag-row {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-bottom: 28px;
    }
    .tag {
      font-size: 10px;
      letter-spacing: 0.08em;
      color: var(--fg4);
      border: 1px solid var(--border);
      padding: 3px 10px;
      background: var(--bg1);
    }
    .hero-install {
      display: flex;
      align-items: center;
      gap: 0;
      margin-bottom: 20px;
      border: 1px solid var(--border);
      background: var(--bg1);
      overflow: hidden;
      max-width: 360px;
    }
    .hero-install-prompt {
      padding: 9px 12px;
      color: var(--fg4);
      font-size: 13px;
      border-right: 1px solid var(--border);
      user-select: none;
    }
    .hero-install code {
      padding: 9px 14px;
      font-size: 13px;
      color: var(--fg1);
      flex: 1;
    }
    .hero-actions { display: flex; gap: 8px; flex-wrap: wrap; }
    .btn-primary {
      font-family: var(--mono);
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.06em;
      background: var(--fg);
      color: var(--bg);
      padding: 10px 20px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      border: 1px solid var(--fg);
    }
    .btn-primary:hover { background: #e4e4e7; }
    .btn-secondary {
      font-family: var(--mono);
      font-size: 12px;
      letter-spacing: 0.06em;
      background: transparent;
      color: var(--fg2);
      padding: 10px 20px;
      border: 1px solid var(--border2);
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .btn-secondary:hover { border-color: var(--fg4); color: var(--fg1); }

    /* Terminal window */
    .terminal {
      background: var(--bg1);
      height: 100%;
    }
    .terminal-bar {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 10px 14px;
      border-bottom: 1px solid var(--border);
      background: var(--bg2);
    }
    .terminal-dot { width: 10px; height: 10px; border-radius: 50%; }
    .terminal-title {
      font-size: 11px;
      color: var(--fg4);
      margin-left: 8px;
      letter-spacing: 0.04em;
    }
    .terminal-body { padding: 20px; font-size: 12px; line-height: 1.8; }
    .t-dim { color: var(--fg4); }
    .t-green { color: var(--green); }
    .t-blue { color: #60a5fa; }
    .t-yellow { color: var(--yellow); }
    .t-white { color: var(--fg1); }
    .t-prompt { color: var(--fg4); margin-right: 8px; }

    /* Code window */
    .code-window {
      border-top: 1px solid var(--border);
    }
    .code-window-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 8px 14px;
      border-bottom: 1px solid var(--border);
      background: var(--bg2);
    }
    .code-window-file { font-size: 11px; color: var(--fg4); letter-spacing: 0.04em; }
    .code-window-lang { font-size: 10px; color: var(--fg5); letter-spacing: 0.08em; text-transform: uppercase; }
    .code-window-body { padding: 16px 20px; font-size: 12px; line-height: 1.8; overflow-x: auto; }
    .kw { color: #c084fc; }
    .fn { color: #60a5fa; }
    .str { color: #86efac; }
    .cm { color: var(--fg5); }
    .prop { color: var(--fg1); }
    .num { color: #fb923c; }
    /* ── INSTALL SECTION ── */
    .install-section { padding: 56px 0; border-bottom: 1px solid var(--border); }
    .install-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; margin-top: 32px; }
    .install-tabs { display: flex; gap: 0; border-bottom: 1px solid var(--border); margin-bottom: 0; }
    .install-tab {
      font-size: 11px;
      letter-spacing: 0.06em;
      padding: 8px 16px;
      background: transparent;
      color: var(--fg4);
      border: none;
      border-bottom: 2px solid transparent;
      cursor: pointer;
    }
    .install-tab.active { color: var(--fg1); border-bottom-color: var(--fg1); }
    .install-tab:hover { color: var(--fg2); }
    .install-box {
      border: 1px solid var(--border);
      border-top: none;
      background: var(--bg1);
    }
    .install-cmd {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 16px;
    }
    .install-cmd code { font-size: 13px; color: var(--fg1); }
    .install-cmd span { color: var(--fg4); margin-right: 8px; }
    .copy-btn {
      font-size: 10px;
      color: var(--fg4);
      background: transparent;
      border: 1px solid var(--border);
      padding: 3px 8px;
      letter-spacing: 0.04em;
    }
    .copy-btn:hover { color: var(--fg2); border-color: var(--fg4); }

    /* ── SECTIONS SHARED ── */
    .section { padding: 64px 0; border-bottom: 1px solid var(--border); }
    .section-label {
      font-size: 10px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--fg4);
      margin-bottom: 8px;
    }
    .section-title {
      font-size: clamp(20px, 3vw, 28px);
      font-weight: 700;
      letter-spacing: -0.01em;
      color: var(--fg);
      margin-bottom: 8px;
    }
    .section-sub { font-size: 13px; color: var(--fg4); margin-bottom: 40px; }

    /* ── QUICK START ── */
    .quickstart-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1px;
      background: var(--border);
      border: 1px solid var(--border);
      margin-top: 32px;
    }
    .qs-panel { background: var(--bg); padding: 0; }
    .qs-panel-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 8px 14px;
      border-bottom: 1px solid var(--border);
      background: var(--bg2);
    }
    .qs-panel-file { font-size: 11px; color: var(--fg4); letter-spacing: 0.04em; }
    .qs-panel-body { padding: 16px; font-size: 11.5px; line-height: 1.8; overflow-x: auto; }

    /* ── FEATURES ── */
    .features-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1px;
      background: var(--border);
      border: 1px solid var(--border);
      margin-top: 40px;
    }
    .feature-card {
      background: var(--bg);
      padding: 24px 20px;
    }
    .feature-card:hover { background: var(--bg1); }
    .feature-icon {
      font-size: 18px;
      margin-bottom: 12px;
      display: block;
    }
    .feature-card-title {
      font-size: 12px;
      font-weight: 600;
      color: var(--fg1);
      letter-spacing: 0.04em;
      margin-bottom: 6px;
      text-transform: uppercase;
    }
    .feature-card-body { font-size: 12px; color: var(--fg4); line-height: 1.6; }
    .feature-items { display: flex; flex-direction: column; gap: 3px; margin-top: 8px; }
    .feature-item { font-size: 11px; color: var(--fg5); }

    /* ── ROUTES ── */
    .routes-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1px;
      background: var(--border);
      border: 1px solid var(--border);
      margin-top: 32px;
    }
    .route-row {
      display: flex;
      align-items: center;
      gap: 12px;
      background: var(--bg);
      padding: 10px 16px;
      border-bottom: 1px solid var(--border);
    }
    .route-row:hover { background: var(--bg1); }
    .route-method {
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.06em;
      padding: 2px 7px;
      min-width: 42px;
      text-align: center;
    }
    .method-get { background: #052e16; color: var(--green); }
    .method-post { background: #1e3a5f; color: #60a5fa; }
    .method-delete { background: #3b0000; color: #f87171; }
    .route-path { font-size: 12px; color: var(--fg1); flex: 1; }
    .route-desc { font-size: 11px; color: var(--fg4); text-align: right; }

    /* ── PACKAGES ── */
    .packages-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1px;
      background: var(--border);
      border: 1px solid var(--border);
      margin-top: 40px;
    }
    .pkg-card {
      background: var(--bg);
      padding: 20px;
    }
    .pkg-card:hover { background: var(--bg1); }
    .pkg-name { font-size: 12px; font-weight: 600; color: var(--fg1); margin-bottom: 6px; }
    .pkg-desc { font-size: 11px; color: var(--fg4); line-height: 1.6; margin-bottom: 12px; }
    .pkg-version { font-size: 10px; color: var(--fg5); letter-spacing: 0.04em; }
    .pkg-link { font-size: 10px; color: var(--fg4); margin-top: 8px; display: block; }
    .pkg-link:hover { color: var(--fg2); }
    .view-all-link { font-size: 11px; color: var(--fg4); letter-spacing: 0.04em; }
    .view-all-link:hover { color: var(--fg2); }

    /* ── OAUTH PROVIDERS ── */
    .providers-row {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 32px;
    }
    .provider-badge {
      display: flex;
      align-items: center;
      gap: 7px;
      font-size: 11px;
      color: var(--fg3);
      border: 1px solid var(--border);
      padding: 7px 14px;
      background: var(--bg1);
      letter-spacing: 0.04em;
    }
    .provider-badge:hover { border-color: var(--border2); color: var(--fg1); }
    .provider-more {
      font-size: 11px;
      color: var(--fg4);
      border: 1px solid var(--border);
      padding: 7px 14px;
      background: var(--bg1);
    }

    /* ── MCP ── */
    .mcp-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1px;
      background: var(--border);
      border: 1px solid var(--border);
      margin-top: 40px;
    }
    .mcp-left { background: var(--bg); padding: 32px 28px; }
    .mcp-right { background: var(--bg1); padding: 0; }
    .mcp-tools-list { display: flex; flex-direction: column; gap: 1px; background: var(--border); }
    .mcp-tool-row {
      background: var(--bg);
      padding: 12px 20px;
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
    .mcp-tool-row:hover { background: var(--bg1); }
    .mcp-tool-name { font-size: 12px; font-weight: 600; color: var(--fg1); }
    .mcp-tool-desc { font-size: 11px; color: var(--fg4); }
    .mcp-endpoint {
      font-size: 11px;
      color: var(--fg3);
      border: 1px solid var(--border);
      padding: 8px 12px;
      background: var(--bg1);
      margin-top: 16px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .mcp-endpoint code { color: var(--fg2); font-size: 11px; }
    .mcp-clients { display: flex; flex-direction: column; gap: 8px; margin-top: 16px; }
    .mcp-client-row { font-size: 11px; color: var(--fg4); display: flex; align-items: center; gap: 8px; }
    .mcp-dot { width: 4px; height: 4px; border-radius: 50%; background: var(--fg5); flex-shrink: 0; }

    /* ── WHATS COMING ── */
    .coming-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1px;
      background: var(--border);
      border: 1px solid var(--border);
      margin-top: 40px;
    }
    .coming-card { background: var(--bg); padding: 20px; }
    .coming-card:hover { background: var(--bg1); }
    .coming-title { font-size: 12px; font-weight: 600; color: var(--fg1); margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.04em; }
    .coming-desc { font-size: 11px; color: var(--fg4); line-height: 1.6; }
    .coming-badge {
      display: inline-block;
      font-size: 9px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--fg5);
      border: 1px solid var(--border);
      padding: 2px 7px;
      margin-bottom: 10px;
    }

    /* ── THREE STEPS ── */
    .steps-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1px;
      background: var(--border);
      border: 1px solid var(--border);
      margin-top: 40px;
    }
    .step-card { background: var(--bg); padding: 32px 24px; }
    .step-num {
      font-size: 36px;
      font-weight: 800;
      color: var(--fg5);
      letter-spacing: -0.04em;
      margin-bottom: 16px;
    }
    .step-title { font-size: 12px; font-weight: 600; color: var(--fg1); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 8px; }
    .step-desc { font-size: 12px; color: var(--fg4); line-height: 1.65; }

    /* ── CTA ── */
    .cta-section {
      padding: 72px 0;
      border-bottom: 1px solid var(--border);
      text-align: center;
    }
    .cta-title { font-size: clamp(24px, 4vw, 40px); font-weight: 800; color: var(--fg); margin-bottom: 12px; letter-spacing: -0.02em; }
    .cta-sub { font-size: 13px; color: var(--fg4); margin-bottom: 28px; }
    .cta-actions { display: flex; align-items: center; justify-content: center; gap: 10px; }

    /* ── FOOTER ── */
    footer { padding: 28px 0; border-top: 1px solid var(--border); }
    .footer-inner { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; }
    .footer-copy { font-size: 11px; color: var(--fg5); }
    .footer-links { display: flex; gap: 20px; }
    .footer-link { font-size: 11px; color: var(--fg5); letter-spacing: 0.04em; }
    .footer-link:hover { color: var(--fg3); }

    /* ── RESPONSIVE ── */
    @media (max-width: 900px) {
      .hero-grid, .install-grid, .mcp-grid { grid-template-columns: 1fr; }
      .hero-right { border-left: none; border-top: 1px solid var(--border); }
      .quickstart-grid, .features-grid, .packages-grid, .coming-grid { grid-template-columns: 1fr 1fr; }
      .routes-grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 600px) {
      .quickstart-grid, .features-grid, .packages-grid, .coming-grid, .steps-grid { grid-template-columns: 1fr; }
      .nav-links { display: none; }
    }
  </style>
</head>
<body>

  <!-- ── TOP BAR ── -->
  <div class="topbar">
    <div class="container">
      <div class="topbar-inner">
        <div class="topbar-left">
          <span class="version-badge">v1.0.0</span>
          <span class="prod-badge">Production Ready</span>
        </div>
      </div>
    </div>
  </div>

  <!-- ── NAV ── -->
  <nav>
    <div class="container">
      <div class="nav-inner">
        <a href="/" class="nav-logo">Gately Auth</a>
        <div class="nav-links">
          <a href="/article/quick-start" class="nav-link">Docs</a>
          <a href="/article/cli-overview" class="nav-link">Guides</a>
          <a href="/article/core-api" class="nav-link">API</a>
          <a href="/article/admin-plugin" class="nav-link">Adapters</a>
          <a href="https://mcp.auth.usegately.com" class="nav-link" target="_blank" rel="noopener">MCP</a>
        </div>
        <div class="nav-actions">
          <a href="https://github.com/gately-auth/gately-auth" class="btn-sm" target="_blank" rel="noopener">
            ★ Star
            <span class="star-count">1.2k</span>
          </a>
          <a href="/article/quick-start" class="btn-sm-primary">Get Started</a>
        </div>
      </div>
    </div>
  </nav>

  <!-- ── HERO ── -->
  <section class="hero section-border">
    <div class="container">
      <div class="hero-grid">
        <!-- LEFT -->
        <div class="hero-left">
          <p class="hero-eyebrow">v1.0.0 · Production Ready</p>
          <h1>Auth for<br />Cloudflare<br />Workers.</h1>
          <p class="hero-sub">The authentication framework built specifically for Cloudflare Workers and the edge.</p>
          <div class="tag-row">
            <span class="tag">OAuth</span>
            <span class="tag">Email + Password</span>
            <span class="tag">Magic Links</span>
            <span class="tag">Sessions</span>
            <span class="tag">MFA</span>
            <span class="tag">Plugins</span>
          </div>
          <div class="hero-install">
            <span class="hero-install-prompt">$</span>
            <code>npm create gately-auth@latest</code>
          </div>
          <div class="hero-actions">
            <a href="/article/quick-start" class="btn-primary">Get Started →</a>
            <a href="/article/quick-start" class="btn-secondary">Documentation</a>
          </div>
          <div class="tag-row" style="margin-top:24px;margin-bottom:0;">
            <span class="tag">🐎 Hono</span>
            <span class="tag">▲ Next.js</span>
            <span class="tag">⚡ Astro</span>
            <span class="tag">🟠 SvelteKit</span>
            <span class="tag">💿 Remix</span>
