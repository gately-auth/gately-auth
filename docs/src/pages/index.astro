---
export const prerender = false;

import '../styles/landing.css';

import LandingNav from '../components/landing/LandingNav.astro';
import LandingHero from '../components/landing/LandingHero.astro';
import LandingInstall from '../components/landing/LandingInstall.astro';
import LandingCode from '../components/landing/LandingCode.astro';
import LandingFeatures from '../components/landing/LandingFeatures.astro';
import LandingRoutes from '../components/landing/LandingRoutes.astro';
import LandingPackages from '../components/landing/LandingPackages.astro';
import LandingPlugins from '../components/landing/LandingPlugins.astro';
import LandingProviders from '../components/landing/LandingProviders.astro';
import LandingIntegrations from '../components/landing/LandingIntegrations.astro';
import LandingDocs from '../components/landing/LandingDocs.astro';
import LandingMCP from '../components/landing/LandingMCP.astro';
import LandingRoadmap from '../components/landing/LandingRoadmap.astro';
import LandingSteps from '../components/landing/LandingSteps.astro';
import LandingFooter from '../components/landing/LandingFooter.astro';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Gately Auth - Auth for Cloudflare Workers</title>
  <meta name="description" content="Production-grade auth for Cloudflare Workers. D1 + KV + email/password, magic links, OTP, OAuth." />
  <link rel="icon" type="image/png" href="/Logo-nvc.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Onest:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <style>
    @font-face {
      font-family: 'Geist Mono';
      src: url('/Geist_Mono/GeistMono-VariableFont_wght.ttf') format('truetype-variations');
      font-weight: 100 900;
      font-style: normal;
      font-display: swap;
    }
  </style>
</head>
<body>

<canvas id="noise-canvas" aria-hidden="true"></canvas>
<div id="cursor-glow" aria-hidden="true"></div>

<div id="layout">
  <LandingNav />
  <main style="padding-top:48px">
    <LandingHero />
    <LandingInstall />
    <LandingCode />
    <LandingFeatures />
    <LandingRoutes />
    <LandingPackages />
    <LandingPlugins />
    <LandingProviders />
    <LandingDocs />
    <LandingIntegrations />
    <LandingMCP />
    <LandingRoadmap />
    <LandingSteps />
  </main>
  <LandingFooter />
</div>

<script>
(function () {
  // Noise canvas
  const c = document.getElementById('noise-canvas') as HTMLCanvasElement;
  if (!c) return;
  const ctx = c.getContext('2d');
  let frame = 0;
  let raf: number;
  function resize() { c.width = window.innerWidth; c.height = window.innerHeight; }
  function draw() {
    if (!ctx) return;
    const w = c.width, h = c.height;
    const img = ctx.createImageData(w, h);
    const buf = img.data;
    let seed = frame * 1234567 + 987654;
    for (let i = 0; i < buf.length; i += 4) {
      seed = (seed * 1664525 + 1013904223) & 0xffffffff;
      const v = (seed >>> 24) & 0xff;
      buf[i] = buf[i+1] = buf[i+2] = v;
      buf[i+3] = 255;
    }
    ctx.putImageData(img, 0, 0);
    frame++;
  }
  function loop() { draw(); raf = requestAnimationFrame(loop); }
  resize();
  window.addEventListener('resize', resize);
  loop();
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) cancelAnimationFrame(raf); else loop();
  });
})();

// Cursor glow spotlight
(function () {
  const glow = document.getElementById('cursor-glow');
  if (!glow || window.matchMedia('(hover: none)').matches) return;

  let mx = window.innerWidth / 2;
  let my = window.innerHeight / 2;
  let cx = mx, cy = my;
  let visible = false;
  let raf: number;

  document.addEventListener('mousemove', (e) => {
    mx = e.clientX;
    my = e.clientY;
    if (!visible) {
      visible = true;
      glow.classList.add('visible');
    }
  });

  document.addEventListener('mouseleave', () => {
    visible = false;
    glow.classList.remove('visible');
  });

  function animate() {
    // Smooth lerp — feels springy
    cx += (mx - cx) * 0.1;
    cy += (my - cy) * 0.1;
    glow.style.left = cx + 'px';
    glow.style.top = cy + 'px';
    raf = requestAnimationFrame(animate);
  }
  animate();
})();
const observer = new IntersectionObserver(
  (entries) => entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('in'); }),
  { threshold: 0.08 }
);
document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

// Stagger grid children
document.querySelectorAll('.l-fg, .l-pkg-grid, .l-cs-grid, .l-steps-row').forEach(grid => {
  observer.observe(grid);
  grid.querySelectorAll(':scope > *').forEach((child, i) => {
    (child as HTMLElement).style.transitionDelay = `${i * 0.06}s`;
    child.classList.add('reveal');
    observer.observe(child);
  });
});

// ── Scramble text on hover ──────────────────────────────────────────────────
const CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
function scramble(el: HTMLElement) {
  const original = el.getAttribute('data-scramble') || el.textContent?.trim() || '';
  let iter = 0;
  let interval: ReturnType<typeof setInterval>;
  clearInterval((el as any)._scramble);
  interval = setInterval(() => {
    el.textContent = original.split('').map((ch, i) => {
      if (ch === ' ') return ' ';
      if (i < iter) return original[i];
      return CHARS[Math.floor(Math.random() * CHARS.length)];
    }).join('');
    iter += 0.8;
    if (iter >= original.length) {
      el.textContent = original;
      clearInterval(interval);
    }
  }, 28);
  (el as any)._scramble = interval;
}

// Nav links
document.querySelectorAll('[data-scramble]').forEach(el => {
  el.addEventListener('mouseenter', () => scramble(el as HTMLElement));
});

// Section labels — scramble on scroll into view
const labelObserver = new IntersectionObserver((entries) => {
  entries.forEach(e => {
    if (e.isIntersecting) {
      setTimeout(() => scramble(e.target as HTMLElement), 100);
      labelObserver.unobserve(e.target);
    }
  });
}, { threshold: 0.5 });
document.querySelectorAll('.l-split-label, .stag').forEach(el => {
  (el as HTMLElement).setAttribute('data-scramble', (el.textContent || '').trim().toUpperCase());
  labelObserver.observe(el);
});

// ── Typed-text effect on hero headline ─────────────────────────────────────
(function() {
  const h1 = document.querySelector('.l-hero-left h1');
  if (!h1) return;
  const lines = h1.innerHTML.split('<br>');
  h1.style.opacity = '1';
})();

// ── Number counter animations ───────────────────────────────────────────────
function animateCount(el: HTMLElement, target: number, suffix = '') {
  let start = 0;
  const duration = 1200;
  const step = (timestamp: number, startTime: number) => {
    const progress = Math.min((timestamp - startTime) / duration, 1);
    const ease = 1 - Math.pow(1 - progress, 3);
    el.textContent = Math.floor(ease * target) + suffix;
    if (progress < 1) requestAnimationFrame(ts => step(ts, startTime));
  };
  requestAnimationFrame(ts => step(ts, ts));
}
const countObserver = new IntersectionObserver((entries) => {
  entries.forEach(e => {
    if (e.isIntersecting) {
      const el = e.target as HTMLElement;
      const target = parseInt(el.getAttribute('data-count') || '0');
      const suffix = el.getAttribute('data-suffix') || '';
      animateCount(el, target, suffix);
      countObserver.unobserve(el);
    }
  });
}, { threshold: 0.5 });
document.querySelectorAll('[data-count]').forEach(el => countObserver.observe(el));

// ── Stagger route rows ──────────────────────────────────────────────────────
document.querySelectorAll('.l-rt').forEach(table => {
  table.querySelectorAll('.l-rr').forEach((row, i) => {
    (row as HTMLElement).style.opacity = '0';
    (row as HTMLElement).style.transform = 'translateX(-8px)';
    (row as HTMLElement).style.transition = `opacity 0.3s ease ${i * 0.03}s, transform 0.3s ease ${i * 0.03}s`;
  });
  const rtObs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.querySelectorAll('.l-rr').forEach((row) => {
          (row as HTMLElement).style.opacity = '1';
          (row as HTMLElement).style.transform = 'translateX(0)';
        });
        rtObs.unobserve(e.target);
      }
    });
  }, { threshold: 0.1 });
  rtObs.observe(table);
});
</script>

</body>
</html>
