<script>
// Noise animation
(function(){
  const c=document.getElementById('noise-canvas');
  if(!c)return;
  const x=c.getContext('2d');
  let f=0,a;
  function r(){c.width=window.innerWidth;c.height=window.innerHeight;}
  function draw(){
    const w=c.width,h=c.height,d=x.createImageData(w,h),b=d.data;
    let s=f*1234567+987654;
    for(let i=0;i<b.length;i+=4){s=(s*1664525+1013904223)&0xffffffff;const v=(s>>>24)&0xff;b[i]=b[i+1]=b[i+2]=v;b[i+3]=255;}
    x.putImageData(d,0,0);f++;
  }
  function loop(){draw();a=requestAnimationFrame(loop);}
  r();window.addEventListener('resize',r);loop();
  document.addEventListener('visibilitychange',()=>{document.hidden?cancelAnimationFrame(a):loop();});
})();

// Scramble text effect on section labels (.stag)
(function() {
  const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789#$%@![]';
  
  function scramble(el) {
    const original = el.getAttribute('data-text') || el.textContent.replace(/^\[|\]$/g, '').trim();
    if (!el.getAttribute('data-text')) el.setAttribute('data-text', original);
    
    const display = `[ ${original.toUpperCase()} ]`;
    let iteration = 0;
    
    clearInterval(el._si);
    el._si = setInterval(() => {
      el.textContent = display
        .split('')
        .map((char, i) => {
          if (char === ' ' || char === '[' || char === ']') return char;
          if (i < iteration) return display[i];
          return chars[Math.floor(Math.random() * chars.length)];
        })
        .join('');
      
      iteration += 1.2;
      if (iteration >= display.length) {
        el.textContent = display;
        clearInterval(el._si);
      }
    }, 35);
  }

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting && !entry.target._done) {
        entry.target._done = true;
        scramble(entry.target);
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.5 });

  document.querySelectorAll('.stag').forEach(el => observer.observe(el));

  // Also scramble immediately for first visible ones
  document.querySelectorAll('.stag').forEach(el => {
    const rect = el.getBoundingClientRect();
    if (rect.top < window.innerHeight) {
      el._done = true;
      scramble(el);
    }
  });
})();

// Scroll reveal animations
(function() {
  const io = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('in');
        io.unobserve(entry.target);
      }
    });
  }, { threshold: 0.12 });

  // Animate individual reveal elements
  document.querySelectorAll('.reveal').forEach(el => io.observe(el));

  // Animate grid parents (triggers child stagger via CSS)
  document.querySelectorAll('.fg, .plg, .sg, .cs-grid-wide, .social-grid').forEach(el => {
    io.observe(el);
  });

  // Also animate the code grid, route table, package list
  const gridObs = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.style.opacity = '1';
        entry.target.style.transform = 'translateY(0)';
        gridObs.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.code-grid, .rt, .pkgl').forEach(el => {
    el.style.opacity = '0';
    el.style.transform = 'translateY(20px)';
    el.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
    gridObs.observe(el);
  });
})();
const cmds = {
  npm:  'npm install @gately/auth-core @gately/auth-client',
  pnpm: 'pnpm add @gately/auth-core @gately/auth-client',
  yarn: 'yarn add @gately/auth-core @gately/auth-client',
  bun:  'bun add @gately/auth-core @gately/auth-client',
};

function showTab(pm) {
  const el = document.getElementById('install-cmd');
  if (el) el.textContent = cmds[pm];
  document.querySelectorAll('.itab').forEach(t => {
    t.classList.toggle('active', t.getAttribute('data-pm') === pm);
  });
}

function copyText(sourceId, btnId) {
  const el = document.getElementById(sourceId);
  const btn = document.getElementById(btnId);
  if (!el || !btn) return;
  const text = el.textContent.trim();

  function onSuccess() {
    btn.textContent = 'Copied!';
    btn.style.color = '#4ade80';
    btn.style.borderColor = '#14532d';
    setTimeout(() => {
      btn.textContent = 'Copy';
      btn.style.color = '';
      btn.style.borderColor = '';
    }, 2000);
  }

  // Try modern clipboard API first
  if (navigator.clipboard && window.isSecureContext) {
    navigator.clipboard.writeText(text).then(onSuccess).catch(() => fallbackCopy(text, onSuccess));
  } else {
    fallbackCopy(text, onSuccess);
  }
}

function fallbackCopy(text, onSuccess) {
  // Create a temporary textarea, select it, copy
  const ta = document.createElement('textarea');
  ta.value = text;
  ta.style.position = 'fixed';
  ta.style.top = '-9999px';
  ta.style.left = '-9999px';
  document.body.appendChild(ta);
  ta.focus();
  ta.select();
  try {
    document.execCommand('copy');
    onSuccess();
  } catch(e) {
    console.warn('Copy failed:', e);
  } finally {
    document.body.removeChild(ta);
  }
}

function copyInstall() {
  copyText('install-cmd', 'btn-install');
}
(function(){
  function updateRails(){
    const el = document.querySelector('.c');
    if(!el) return;
    const rect = el.getBoundingClientRect();
    document.documentElement.style.setProperty('--rail-left', rect.left + 'px');
    document.documentElement.style.setProperty('--rail-right', (window.innerWidth - rect.right) + 'px');
  }
  updateRails();
  window.addEventListener('resize', updateRails);
})();
</script>
