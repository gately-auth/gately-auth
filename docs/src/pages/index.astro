---
export const prerender = false;

const authCode = `<span class="t-dim">import</span> <span class="t-w">&#123; gatelyAuth &#125;</span> <span class="t-dim">from</span> <span class="t-s">'@gately/auth-core'</span>
<span class="t-dim">import</span> <span class="t-w">&#123; createD1Adapter, createKVStore &#125;</span> <span class="t-dim">from</span> <span class="t-s">'@gately/auth-core/adapters'</span>
<span class="t-dim">import</span> <span class="t-w">&#123; gatelyEmail &#125;</span> <span class="t-dim">from</span> <span class="t-s">'@gately/auth-core/plugins'</span>

<span class="t-dim">export function</span> <span class="t-w">createAuth</span><span class="t-p">(env: Env) &#123;</span>
  <span class="t-dim">return</span> <span class="t-w">gatelyAuth</span><span class="t-p">(&#123;</span>
    <span class="t-k">secret</span><span class="t-p">:</span> <span class="t-g">env.AUTH_SECRET,</span>
    <span class="t-k">db</span><span class="t-p">:</span> <span class="t-w">createD1Adapter</span><span class="t-p">(</span><span class="t-g">env.AUTH_DB</span><span class="t-p">),</span>
    <span class="t-k">kv</span><span class="t-p">:</span> <span class="t-w">createKVStore</span><span class="t-p">(</span><span class="t-g">env.AUTH_KV</span><span class="t-p">),</span>
    <span class="t-k">emailAndPassword</span><span class="t-p">: &#123;</span> <span class="t-k">enabled</span><span class="t-p">:</span> <span class="t-dim">true</span> <span class="t-p">&#125;,</span>
    <span class="t-k">plugins</span><span class="t-p">: [</span><span class="t-w">gatelyEmail</span><span class="t-p">(&#123;</span> <span class="t-k">apiKey</span><span class="t-p">:</span> <span class="t-g">env.GATELY_API_KEY</span> <span class="t-p">&#125;)],</span>
  <span class="t-p">&#125;)</span>
<span class="t-p">&#125;</span>`;

const workerCode = `<span class="t-dim">import</span> <span class="t-w">&#123; createAuth &#125;</span> <span class="t-dim">from</span> <span class="t-s">'./auth'</span>

<span class="t-dim">export default</span> <span class="t-p">&#123;</span>
  <span class="t-dim">async</span> <span class="t-w">fetch</span><span class="t-p">(req: Request, env: Env) &#123;</span>
    <span class="t-dim">const</span> <span class="t-w">auth</span> <span class="t-p">=</span> <span class="t-w">createAuth</span><span class="t-p">(env)</span>

    <span class="t-dim">// Mount all /auth/* routes</span>
    <span class="t-dim">return</span> <span class="t-w">auth</span><span class="t-p">.</span><span class="t-w">handler</span><span class="t-p">(req)</span>
  <span class="t-p">&#125;,</span>
<span class="t-p">&#125;</span>

<span class="t-dim">// Protect any route server-side</span>
<span class="t-dim">const</span> <span class="t-w">session</span> <span class="t-p">=</span> <span class="t-dim">await</span> <span class="t-w">auth</span><span class="t-p">.</span><span class="t-w">api</span><span class="t-p">.</span><span class="t-w">getSession</span><span class="t-p">(req)</span>
<span class="t-dim">if</span> <span class="t-p">(!</span><span class="t-w">session</span><span class="t-p">)</span> <span class="t-dim">return new</span> <span class="t-w">Response</span><span class="t-p">(</span><span class="t-s">'401'</span><span class="t-p">, &#123;</span> <span class="t-k">status</span><span class="t-p">: 401 &#125;)</span>`;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Gately Auth — Auth for Cloudflare Workers</title>
  <meta name="description" content="Production-grade auth for Cloudflare Workers. D1 + KV + email/password, magic links, OTP, OAuth." />
  <link rel="icon" type="image/png" href="/Logo-nvc.png" />
  <style>
    @font-face {
      font-family: 'Geist Mono';
      src: url('/Geist_Mono/GeistMono-VariableFont_wght.ttf') format('truetype-variations');
      font-weight: 100 900; font-style: normal; font-display: swap;
    }
    @import url('https://fonts.googleapis.com/css2?family=Onest:wght@300;400;500;600;700;800;900&display=swap');
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body {
      background: #000; color: #fff;
      font-family: 'Onest', system-ui, sans-serif;
      font-size: 14px; line-height: 1.6;
      -webkit-font-smoothing: antialiased; overflow-x: hidden;
    }
    /* Geist Mono — nav, buttons, labels, code */
    .nav-link, .nav-cta, .nav-logo,
    .btn, .stag, .itab, .copy-btn, .itab.active,
    .hero-badge, .hero-sub, .ss, .prompt-label, .prompt-tag,
    .fw-tag, .fwt, .pkgd, .fc, .fl, .ft, .fn, .pt, .cs-soon, .cs-title,
    pre, code, kbd, samp {
      font-family: 'Geist Mono', ui-monospace, Menlo, Consolas, monospace;
    }
    /* Onest — headings, body descriptions */
    .sh, .sd, .fi .fd, .pi .pd, .hero-sub-body, h2, h3 {
      font-family: 'Onest', system-ui, sans-serif;
    }
    #noise-canvas {
      position: fixed; inset: 0; width: 100vw; height: 100vh;
      pointer-events: none; z-index: 0; opacity: 0.04; mix-blend-mode: screen;
    }
    nav, section, footer { position: relative; z-index: 1; width: 100%; }
    a { color: inherit; text-decoration: none; }
    .c { width: 100%; padding: 0 48px; }
    .bd { border-bottom: 1px solid #111; }

    /* LAYOUT WRAPPER — all content constrained with left/right borders */
    #layout {
      max-width: 1400px;
      margin: 0 auto;
      border-left: 1px solid #111;
      border-right: 1px solid #111;
      min-height: 100vh;
      position: relative;
      z-index: 1;
    }
    /* Remove the pseudo-element rail approach */
    .c::before, .c::after { display: none; }
    /* NAV */
    nav { border-bottom: 1px solid #111; position: fixed; top: 0; left: 0; right: 0; background: rgba(0,0,0,0.92); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); z-index: 100; }
    .nav-i { display: flex; align-items: center; justify-content: space-between; height: 54px; max-width: 1400px; margin: 0 auto; padding: 0 48px; }
    .nav-logo { font-weight: 800; font-size: 13px; letter-spacing: 0.1em; text-transform: uppercase; }
    .nav-links { display: flex; align-items: center; gap: 28px; }
    .nav-link { font-size: 11px; letter-spacing: 0.08em; color: #555; text-transform: uppercase; }
    .nav-link:hover { color: #fff; }
    .nav-cta { font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; background: #fff; color: #000; padding: 8px 20px; }
    .nav-cta:hover { background: #ddd; }
    /* HERO — fixed height, text left, image absolute right */
    /* HERO — fixed height, bg image, text left */
    .hero { padding: 0; height: 700px; position: relative; overflow: hidden; background: url('/herobg.png') center center / cover no-repeat; }
    .hero::before { display: none; }
    .hero-inner { height: 100%; display: flex; align-items: center; position: relative; z-index: 2; padding-top: 54px; }
    .hero-text { display: flex; flex-direction: column; max-width: 800px; }
    .hero-img {
      position: absolute;
      right: -60px;
      top: 50%;
      transform: translateY(-50%);
      width: 55%;
      max-width: 800px;
      z-index: 1;
      pointer-events: none;
    }
    .hero-img img { width: 100%; height: auto; opacity: 0.92; display: block; }
    .hero-badge { display: inline-flex; align-items: center; gap: 8px; font-family: 'Geist Mono', monospace; font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: #555; border: 1px solid #1a1a1a; padding: 6px 14px; margin-bottom: 40px; width: fit-content; }
    .hero-badge:hover { border-color: #333; color: #aaa; }
    .hero-dot { width: 5px; height: 5px; background: #fff; flex-shrink: 0; }
    .hero-sub { font-family: 'Geist', sans-serif; font-size: 15px; color: #666; max-width: 520px; line-height: 1.7; margin-bottom: 40px; }
    .ss { font-family: 'Geist', sans-serif; font-size: 13px; color: #444; margin-bottom: 48px; line-height: 1.7; }
    .install-sec { padding: 64px 0; }
    .install-tabs { display: flex; gap: 0; border: 1px solid #111; margin-bottom: 0; width: fit-content; }
    .itab { font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; padding: 8px 20px; color: #333; background: #000; border-right: 1px solid #111; cursor: pointer; transition: all 0.1s; }
    .itab:last-child { border-right: none; }
    .itab.active { color: #fff; background: #0d0d0d; }
    .itab:hover { color: #aaa; }
    .install-block { border: 1px solid #111; border-top: none; background: #050505; padding: 18px 20px; display: flex; align-items: center; justify-content: space-between; gap: 16px; }
    .install-block code { font-size: 13px; color: #888; font-family: 'Geist Mono', monospace; }
    .install-block .dol { color: #222; margin-right: 8px; }
    .copy-btn { font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: #333; background: transparent; border: 1px solid #1a1a1a; padding: 5px 12px; cursor: pointer; font-family: 'Geist Mono', monospace; transition: all 0.1s; flex-shrink: 0; }
    .copy-btn:hover { color: #aaa; border-color: #333; }
    /* AGENT PROMPT */
    .prompt-block { border: 1px solid #111; margin-top: 32px; }
    .prompt-hd { display: flex; align-items: center; justify-content: space-between; padding: 10px 20px; border-bottom: 1px solid #111; background: #050505; }
    .prompt-label { font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: #333; }
    .prompt-tag { font-size: 9px; letter-spacing: 0.1em; text-transform: uppercase; color: #222; border: 1px solid #1a1a1a; padding: 2px 8px; }
    .prompt-body { padding: 20px; font-size: 12px; color: #444; line-height: 1.8; background: #000; }
    .prompt-body strong { color: #777; font-weight: 600; }
    /* MCP / SKILLS expanded */
    .cs-grid-wide { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: #111; border: 1px solid #111; margin-top: 48px; }
    @media (max-width: 1100px) { .hero-img { display: none; } .cs-grid-wide { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 600px) { .cs-grid-wide { grid-template-columns: 1fr; } .install-tabs { flex-wrap: wrap; width: 100%; } }
    h1 { font-family: 'Onest', sans-serif; font-size: 76px; font-weight: 800; letter-spacing: -0.03em; text-transform: none; line-height: 1.05; color: #fff; margin-bottom: 28px; white-space: nowrap; }
    h1 .muted { color: #1e1e1e; }
    .sh { font-family: 'Onest', sans-serif; font-size: clamp(22px, 3vw, 38px); font-weight: 400; letter-spacing: -0.01em; text-transform: none !important; color: #fff; margin-bottom: 10px; }
    .nav-logo { font-family: 'Geist Mono', monospace; font-weight: 700; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; display: flex; align-items: center; gap: 10px; }
    .nav-link { font-family: 'Geist Mono', monospace; font-size: 11px; letter-spacing: 0.08em; color: #555; text-transform: uppercase; }
    .nav-link:hover { color: #fff; }
    .nav-cta { font-family: 'Geist Mono', monospace; font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; background: #fff; color: #000; padding: 8px 18px; display: inline-block; }
    .nav-cta:hover { background: #ddd; }
    .stag { font-family: 'Geist Mono', monospace; font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; color: #333; margin-bottom: 20px; }
    .btn { font-family: 'Geist Mono', monospace; font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; padding: 11px 24px; display: inline-block; cursor: pointer; border: none; }
    .itab { font-family: 'Geist Mono', monospace; font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; padding: 8px 20px; color: #333; background: #000; border-right: 1px solid #111; cursor: pointer; transition: all 0.1s; }
    .copy-btn { font-family: 'Geist Mono', monospace; font-size: 10px; letter-spacing: 0.06em; text-transform: uppercase; color: #333; background: transparent; border: 1px solid #1a1a1a; padding: 5px 12px; cursor: pointer; transition: all 0.1s; flex-shrink: 0; }
    .copy-btn:hover { color: #aaa; border-color: #333; }
    .hero-sub { font-family: 'Geist Mono', monospace; font-size: 13px; color: #666; max-width: 520px; line-height: 1.8; margin-bottom: 40px; }
    .ss { font-family: 'Geist Mono', monospace; font-size: 12px; color: #444; margin-bottom: 48px; line-height: 1.8; }
    .hero-sub { font-size: 14px; color: #555; max-width: 520px; line-height: 1.8; margin-bottom: 44px; }
    .hero-actions { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 36px; }
    .btn { font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; padding: 12px 28px; display: inline-block; cursor: pointer; border: none; }
    .btn-w { background: #fff; color: #000; }
    .btn-w:hover { background: #e0e0e0; }
    .btn-o { background: transparent; color: #555; border: 1px solid #222; }
    .btn-o:hover { border-color: #444; color: #fff; }
    .install { display: inline-flex; align-items: center; gap: 10px; background: #080808; border: 1px solid #111; padding: 10px 20px; font-size: 12px; color: #555; }
    .install code { color: #bbb; }
    .install .dol { color: #2a2a2a; }
    /* SHARED */
    .sec { padding: 88px 0; }
    .stag { font-family: 'Geist Mono', monospace; font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; color: #333; margin-bottom: 20px; }
    .ss { font-family: 'Geist Mono', monospace; font-size: 12px; color: #444; margin-bottom: 48px; line-height: 1.8; }
    /* CODE */
    .code-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: #111; border: 1px solid #111; }
    .cp { background: #000; overflow: hidden; }
    .cp-hd { display: flex; align-items: center; justify-content: space-between; padding: 10px 16px; border-bottom: 1px solid #0d0d0d; background: #050505; }
    .cp-f { font-size: 11px; color: #2a2a2a; }
    .cp-l { font-size: 10px; color: #1e1e1e; letter-spacing: 0.08em; text-transform: uppercase; }
    pre { padding: 22px 20px; font-size: 12px; line-height: 1.8; overflow-x: auto; }
    .t-dim { color: #444; } .t-w { color: #fff; } .t-g { color: #777; }
    .t-s { color: #888; } .t-k { color: #bbb; } .t-p { color: #2e2e2e; }
    /* FEATURE CARDS — Better Auth style */
    .fc-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: #111; border: 1px solid #111; margin-top: 48px; }
    .fc-card { background: #000; padding: 28px 24px 24px; position: relative; min-height: 180px; display: flex; flex-direction: column; transition: background 0.15s; text-decoration: none; color: inherit; }
    .fc-card:hover { background: #080808; }
    .fc-top { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 14px; }
    .fc-num { font-family: 'Geist Mono', monospace; font-size: 10px; letter-spacing: 0.1em; color: #222; }
    .fc-arrow { font-size: 14px; color: #1e1e1e; transition: color 0.15s, transform 0.15s; }
    .fc-card:hover .fc-arrow { color: #555; transform: translate(2px, -2px); }
    .fc-title { font-family: 'Onest', sans-serif; font-size: 15px; font-weight: 600; color: #e4e4e7; margin-bottom: 8px; line-height: 1.3; }
    .fc-desc { font-family: 'Onest', sans-serif; font-size: 12px; color: #444; line-height: 1.65; flex: 1; }
    .fc-visual { margin-top: 20px; }
    /* Tag pills for visual elements */
    .fc-tags { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
    .fc-tag { font-family: 'Geist Mono', monospace; font-size: 10px; letter-spacing: 0.06em; color: #333; border: 1px solid #1a1a1a; padding: 3px 8px; background: #080808; }
    .fc-tag.green { color: #4ade80; border-color: #14532d; background: #14532d22; }
    .fc-tag.blue  { color: #60a5fa; border-color: #1e3a5f; background: #1e3a5f22; }
    .fc-tag.red   { color: #f87171; border-color: #5f1e1e; background: #5f1e1e22; }
    /* Provider icons row */
    .fc-providers { display: flex; align-items: center; gap: 8px; }
    .fc-prov { width: 24px; height: 24px; background: #0d0d0d; border: 1px solid #111; display: flex; align-items: center; justify-content: center; }
    .fc-prov svg { width: 12px; height: 12px; fill: #333; }
    .fc-more { font-family: 'Geist Mono', monospace; font-size: 9px; color: #222; border: 1px solid #1a1a1a; padding: 3px 6px; }
    /* Code snippet visual */
    .fc-code { font-family: 'Geist Mono', monospace; font-size: 10px; color: #333; background: #050505; border: 1px solid #0d0d0d; padding: 8px 12px; line-height: 1.6; }
    .fc-code .kw { color: #555; }
    .fc-code .val { color: #777; }
    @media (max-width: 900px) { .fc-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 560px) { .fc-grid { grid-template-columns: 1fr; } }
    /* STEPS */
    .sg { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: #111; border: 1px solid #111; margin-top: 48px; }
    .si { background: #000; padding: 36px 28px; }
    .sn { font-family: 'Onest', sans-serif; font-size: 48px; font-weight: 800; color: #0e0e0e; margin-bottom: 20px; letter-spacing: -0.04em; }
    .st { font-family: 'Geist Mono', monospace; font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #bbb; margin-bottom: 10px; }
    .sd { font-family: 'Onest', sans-serif; font-size: 13px; color: #3a3a3a; line-height: 1.7; }
    .sd code { font-family: 'Geist Mono', monospace; color: #555; font-size: 11px; }
    /* ROUTES TABLE — 2-column grid */
    .rt { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: #111; border: 1px solid #111; margin-top: 48px; }
    .rr { display: flex; align-items: center; gap: 12px; padding: 14px 18px; background: #000; transition: background 0.1s; }
    .rr:hover { background: #070707; }
    .rm { font-size: 10px; font-weight: 700; letter-spacing: 0.06em; padding: 3px 7px; background: #0d0d0d; border: 1px solid #1a1a1a; flex-shrink: 0; min-width: 44px; text-align: center; }
    .rm.get { color: #4ade80; border-color: #14532d; }
    .rm.post { color: #60a5fa; border-color: #1e3a5f; }
    .rm.del { color: #f87171; border-color: #5f1e1e; }
    .rp { font-size: 11px; color: #666; font-family: 'Geist Mono', monospace; }
    /* SOCIAL PROVIDERS */
    .social-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 1px; background: #111; border: 1px solid #111; margin-top: 48px; }
    .soc { background: #000; padding: 28px 20px; display: flex; flex-direction: column; align-items: center; gap: 12px; transition: background 0.1s; }
    .soc:hover { background: #070707; }
    .soc-icon { width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; }
    .soc-icon svg { width: 28px; height: 28px; fill: #333; transition: fill 0.1s; }
    .soc:hover .soc-icon svg { fill: #888; }
    .soc-name { font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: #2a2a2a; }
    /* COMING SOON */
    .cs-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: #111; border: 1px solid #111; margin-top: 48px; }
    .cs { background: #000; padding: 32px 28px; position: relative; overflow: hidden; }
    .cs-soon { font-size: 9px; letter-spacing: 0.14em; text-transform: uppercase; color: #222; border: 1px solid #1a1a1a; padding: 3px 8px; display: inline-block; margin-bottom: 16px; }
    .cs-title { font-size: 13px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #555; margin-bottom: 10px; }
    .cs-desc { font-size: 12px; color: #2a2a2a; line-height: 1.7; }
    .plg { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: #111; border: 1px solid #111; margin-top: 48px; }
    .pi { background: #000; padding: 28px 24px; transition: background 0.1s; }
    .pi:hover { background: #070707; }
    .pt { font-family: 'Geist Mono', monospace; font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #bbb; margin-bottom: 8px; }
    .pd { font-family: 'Onest', sans-serif; font-size: 13px; color: #3a3a3a; line-height: 1.7; }
    /* PACKAGES */
    .pkgl { border: 1px solid #111; margin-top: 48px; }
    .pkgr { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 22px 24px; border-bottom: 1px solid #080808; transition: background 0.1s; }
    .pkgr:last-child { border-bottom: none; }
    .pkgr:hover { background: #060606; }
    .pkgn { font-size: 13px; font-weight: 700; color: #bbb; }
    .pkgd { font-size: 11px; color: #3a3a3a; flex: 1; text-align: right; }
    .pkgv { font-size: 10px; color: #1e1e1e; white-space: nowrap; }
    /* FW */
    .fwr { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; margin-top: 20px; }
    .fwt { font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: #333; border: 1px solid #0f0f0f; padding: 6px 14px; background: #050505; }
    /* CTA */
    .cta { padding: 120px 0; text-align: center; }
    .cta .sh { margin-bottom: 16px; }
    .cta p { font-size: 13px; color: #444; margin-bottom: 40px; max-width: 440px; margin-left: auto; margin-right: auto; line-height: 1.8; }
    .cta-row { display: flex; align-items: center; justify-content: center; gap: 12px; flex-wrap: wrap; }
    /* FOOTER */
